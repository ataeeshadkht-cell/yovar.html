<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دستیار هوشمند یووار (Yovar)</title>
    <style>
        :root {
            --bg-color: #0b070c;
            --card-bg: #16101a;
            --text-color: #fce7f3;
            --accent-red: #e11d48;
            --accent-pink: #f43f5e;
            --accent-glow: rgba(246, 63, 94, 0.3);
            --border-color: #2e1c28;
        }

        body.pas-node {
            --bg-color: #1f0c14;
            --card-bg: #321422;
            --text-color: #f7f1e5;
            --accent-pink: #fda4af;
            --border-color: #58223c;
        }

        body {
            font-family: Tahoma, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            padding-bottom: 95px;
            transition: background 0.4s ease;
        }

        header {
            background: linear-gradient(135deg, #0b070c, #1f0c14, #2e1c28);
            border-bottom: 2px solid var(--accent-red);
            padding: 25px 15px;
            text-align: center;
            border-bottom-left-radius: 30px;
            border-bottom-right-radius: 30px;
            box-shadow: 0 8px 25px var(--accent-glow);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .app-logo {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 3px solid var(--accent-pink);
            object-fit: cover;
            margin-bottom: 12px;
            box-shadow: 0 0 20px var(--accent-pink);
        }

        header h1 { margin: 0; font-size: 24px; color: #fff; text-shadow: 0 0 10px var(--accent-pink); }
        header p { margin: 6px 0 0; font-size: 12px; opacity: 0.85; }

        .container { padding: 15px; max-width: 600px; margin: auto; }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 18px;
            padding: 18px;
            margin-bottom: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.4);
        }

        .chat-container {
            height: 250px;
            overflow-y: auto;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 10px;
            background: rgba(0,0,0,0.2);
            display: flex;
            flex-direction: column;
        }

        .msg {
            max-width: 80%;
            padding: 10px 14px;
            border-radius: 15px;
            margin-bottom: 10px;
            font-size: 14px;
            line-height: 1.4;
            word-wrap: break-word;
        }

        .msg-yovar {
            background: var(--card-bg);
            border: 1px solid var(--accent-pink);
            color: #fff;
            align-self: flex-start;
            border-bottom-left-radius: 2px;
        }

        .msg-user {
            background: var(--accent-pink);
            color: #fff;
            align-self: flex-end;
            border-bottom-right-radius: 2px;
        }

        .input-group {
            display: flex;
            gap: 8px;
        }

        input[type="text"] {
            flex: 1;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
            background: var(--card-bg);
            color: var(--text-color);
            font-family: Tahoma, sans-serif;
        }

        button {
            background: var(--accent-pink);
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
            font-family: Tahoma, sans-serif;
            transition: transform 0.2s, background 0.2s;
        }

        button:active { transform: scale(0.95); }

        .nav-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #120b16;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            z-index: 1000;
        }

        .nav-item {
            text-align: center;
            font-size: 12px;
            color: #94b3bd;
            cursor: pointer;
            flex: 1;
        }

        .nav-item.active {
            color: var(--accent-pink);
            font-weight: bold;
        }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        h3 { margin-top: 0; color: var(--accent-pink); font-size: 18px; }
    </style>
</head>
<body>

    <header>
        <img src="https://images.unsplash.com/photo-1534447677768-be436bb04017?w=800&auto=format&fit=crop&q=80" alt="لوگو" class="app-logo">
        <h1>دستیار هوشمند یووار (Yovar)</h1>
        <p>دستیار سخت‌گیر، متعهد، صبور و معلم خصوصی تو.</p>
    </header>

    <div class="container">
        <!-- تب چت و گفتگو -->
        <div id="tab-chat" class="tab-content active">
            <div class="card">
                <h3>🗣️ گفتگو با یووار</h3>
                <div id="chat-container" class="chat-container">
                    <div class="msg msg-yovar">سلام! من یووار هستم. با هر زبانی که راحت‌تری برنامه‌ت رو پیش ببر، من حواسم بهت هست!</div>
                </div>
                <div class="input-group">
                    <input type="text" id="chat-input" placeholder="پیام خود را بنویسید...">
                    <button onclick="sendMessage()">ارسال</button>
                </div>
            </div>
        </div>
    </div>

    <div class="nav-bar">
        <div class="nav-item active" onclick="switchTab('chat')">💬 چت</div>
    </div>

    <script>
        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            
            document.getElementById('tab-' + tabName).classList.add('active');
            event.currentTarget.classList.add('active');
        }

        function sendMessage() {
            const input = document.getElementById('chat-input');
            const container = document.getElementById('chat-container');
            const text = input.value.trim();
            
            if (!text) return;

            // نمایش پیام کاربر
            container.innerHTML += `<div class="msg msg-user">${text}</div>`;
            input.value = '';
            container.scrollTop = container.scrollHeight;

            // پاسخ خودکار یووار
            setTimeout(() => {
                const replies = [
                    "آفرین قهرمانی که با انرژی ادامه میدهی! ادامه بده.",
                    "من همیشه هوای تلاش‌های تو رو دارم.",
                    "خیلی عالیه! خستگی معنا نداره، به هدفت فکر کن.",
                    "با قدرت ادامه بده، من قدم به قدم باهات هستم."
                ];
                const randomReply = replies[Math.floor(Math.random() * replies.length)];
                container.innerHTML += `<div class="msg msg-yovar">${randomReply}</div>`;
                container.scrollTop = container.scrollHeight;
            }, 500);
        }

        // فعال‌سازی ارسال با کلید اینتر
        document.getElementById('chat-input').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });
    </script>
</body>
</html>
